# Telegram
BOT_TOKEN=
# Optional: comma-separated Telegram user ids allowed to use the bot
ADMIN_IDS=

# panel.exbot.su session cookies
# Set PANEL_REFRESH_NOW once. Access обновляется сам.
# Ротация refresh сохраняется в data/panel_session.json (не нужно править .env).
# Если refresh умер (~30 дней) — в Telegram: /panel_auth
PANEL_REFRESH_NOW=
PANEL_ACCESS_NOW=

# Google Sheets service account
# Path to JSON key file, or paste JSON into GOOGLE_SERVICE_ACCOUNT_JSON
SERVICE_ACCOUNT_PATH=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Spreadsheet (defaults match FOR YOU ZGA)
SPREADSHEET_ID=1wfd3TNHFEY6T3MXyjiUPqzNUsnwWaNhElaq8RLAz-PI
SHEET_GID=1296662959

# Panel
PANEL_BASE_URL=https://panel.exbot.su
SERVER_ID=6

# Local state
DATA_DIR=./data

# Test / offline fallbacks
# Directory with report_log.json and player_requests_z.json
PANEL_FIXTURE_DIR=
# 1 = always use fixtures; 0 = try panel first, fallback to fixtures on 403
PANEL_PREFER_FIXTURES=0
# 1 = force CSV mirror instead of Google Sheets
USE_LOCAL_SHEET=0
